# Fichier .gitignore

# Environnement virtuel de uv (NE JAMAIS VERSIONNER LE .VENV)
.venv/

# Fichiers de cache Python
__pycache__/
*.pyc

# Fichiers de log
*.log

# Fichiers spécifiques au système d'exploitation
.DS_Store

# Ignorer la documentation auto-générée si elle existe
/docs/

#Ignorer les fichier pkl générés
*.pkl

*.db

ml/__pycache__/
ml/*.pyc
mlruns/
tests/__pycache__/
tests/*.pyc
data/__pycache__/
data/*.pyc
model/__pycache__/
model/*.pyc
model/model.pkl
model/model_diabetes_final.pkl
model/scaler.pkl
